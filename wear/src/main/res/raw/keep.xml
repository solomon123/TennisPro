<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds shrink resources, and nothing in our code references
  android_wear_capabilities: Google Play services reads it by name. Without this
  keep, the release watch APK shipped without it and the phone showed "No watch",
  while debug builds (which don't shrink) paired fine.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities" />
