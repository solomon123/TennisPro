<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Recording continues while the activity is backgrounded / screen off, which
      requires a foreground service. From Android 14 (API 34) the service must
      declare a type AND hold the matching FOREGROUND_SERVICE_* permission, and a
      `camera` type service can only be *started* while the app is visible — which
      it is, since the user taps Record.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".TennisProApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TennisPro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TennisPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".camera.RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!--
          Receives watch messages even when the phone UI is not running, so a score
          tap made while the phone screen is off still lands.

          Deliberately no android:permission="...BIND_WEARABLE_LISTENER" here: on a
          real device (Play Services build/version dependent) the Wearable Data
          Layer's own binder does not always hold that permission itself, so
          requiring it causes Play Services to be denied binding to this very
          service — every message silently dropped, both directions, with no error
          visible anywhere except adb logcat's ActivityManager/WearableService
          lines. The wear:-scheme intent-filter below is what actually scopes
          delivery to this app; exported=true plus that filter is sufficient.
        -->
        <service
            android:name=".wear.PhoneWearableListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/tennispro" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
    </application>
</manifest>
